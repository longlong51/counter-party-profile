# 复制为 .env 后生效。所有值均为**占位**，替换为真实配置即可，无需改代码。

# ---------- LLM（主：智谱 GLM-4.7-Flash 免费）----------
LLM_PROVIDER=zhipu
LLM_API_KEY=sk-placeholder-zhipu-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash
LLM_VISION_MODEL=glm-4.6v-flash

# ---------- LLM（备：阿里云百炼）----------
LLM_FALLBACK_API_KEY=sk-placeholder-dashscope-key
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_MODEL=qwen-plus

# ---------- Redis ----------
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# ---------- Oracle ----------
ORACLE_ENABLED=true
ORACLE_DSN=127.0.0.1:1521/XEPDB1
ORACLE_USER=counterparty
ORACLE_PASSWORD=placeholder_password

# ---------- Kafka ----------
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=ai_trading_events

# ---------- MCP（同花顺 iFinD）----------
MCP_ENABLED=true
MCP_BASE_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers
MCP_AUTH_TOKEN=ifind_mcp_placeholder_key

# ---------- RAG 参数 ----------
RETRIEVAL_TOP_K=6
MIN_COSINE=0.30
MIN_BM25=3.0
RRF_K=60

# ---------- 记忆 ----------
SHORT_WINDOW_TURNS=6
SUMMARY_TRIGGER_TURNS=12
LONG_MEMORY_TTL_DAYS=30
